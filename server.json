{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.putervision/world-model-mcp",
  "version": "0.1.0",
  "title": "World Model MCP",
  "description": "Deterministic, persistent 3D/2D spatial world model for AI agents with entity tracking, object permanence, movement simulation, and expected view frustum projection.",
  "publisher": "PuterVision",
  "license": "MIT",
  "websiteUrl": "https://putervision.com",
  "status": "active",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/putervision/world-model-mcp/main/docs/world-model-icon.png",
      "sizes": ["512x512"],
      "mimeType": "image/png"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/putervision/world-model-mcp",
    "source": "github"
  },
  "bugs": {
    "url": "https://github.com/putervision/world-model-mcp/issues"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@putervision/world-model-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "executable": "world-model-mcp",
      "args": [
        "run"
      ]
    }
  ]
}
