# === World Model MCP Configuration ===
WORLD_MODEL_MCP_DIR=.world-model-mcp
WORLD_MODEL_MCP_LOG_LEVEL=info

# === SQLite Performance & Concurrency Tuning ===
WORLD_MODEL_BUSY_TIMEOUT_MS=5000
WORLD_MODEL_MMAP_SIZE_BYTES=134217728

# === Object Permanence & Confidence Decay ===
CONFIDENCE_DECAY_RATE=0.05
CONFIDENCE_DECAY_INTERVAL_MS=60000
MIN_CONFIDENCE_THRESHOLD=0.1
