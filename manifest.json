{
  "manifest_version": "0.2",
  "name": "@putervision/world-model-mcp",
  "version": "0.3.0",
  "description": "Persistent 3D/2D spatial world model for AI agents with entity tracking and simulation.",
  "author": {
    "name": "PuterVision"
  },
  "homepage": "https://github.com/putervision/world-model-mcp#readme",
  "server": {
    "type": "node",
    "entry_point": "./dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/./dist/index.js"
      ],
      "env": {}
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/putervision/world-model-mcp.git"
  }
}
